# Public application URL (no trailing slash)
BETTER_AUTH_URL=https://fluxskin.ru

# PostgreSQL connection string
DATABASE_URL=postgresql://fluxskin:Stas325671@127.0.0.1:5432/fluxskin

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME

# Keep authentication enabled in production.
VITE_AUTH_ENABLED=true

# Optional: enables Google/X through the Flux/Grok OAuth broker.
# Leave these unset if you only want email/password authentication.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=CHANGE_ME
# GROK_AUTH_CLIENT_SECRET=CHANGE_ME

# VPS build target. "node" produces .output/server/index.mjs.
NITRO_PRESET=node
