# FluxSkin production configuration
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/fluxskin
BETTER_AUTH_URL=https://fluxskin.ru
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
VITE_AUTH_ENABLED=true

# Optional federated auth broker
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
