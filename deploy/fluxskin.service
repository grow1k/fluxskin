[Unit]
Description=FluxSkin web application
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
User=fluxskin
Group=fluxskin
WorkingDirectory=/opt/fluxskin
EnvironmentFile=/opt/fluxskin/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/fluxskin/.output/server/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/fluxskin

[Install]
WantedBy=multi-user.target
